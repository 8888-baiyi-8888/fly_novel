{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "NodeNext",
    "paths": {
      "@fly-novel/llm": [
        "./src/llm/index.ts"
      ],
      "@fly-novel/session": [
        "./src/agents/plugins/session/index.ts"
      ],
      "@fly-novel/session-persistence": [
        "./src/agents/plugins/session-persistence/index.ts"
      ],
      "@fly-novel/system-prompt": [
        "./src/agents/plugins/system-prompt/index.ts"
      ],
      "@fly-novel/skill": [
        "./src/agents/plugins/skill/index.ts"
      ],
      "@fly-novel/skill-filesystem": [
        "./src/agents/plugins/skill-filesystem/index.ts"
      ],
      "@fly-novel/tool-skill": [
        "./src/agents/plugins/tool-skill/index.ts"
      ],
      "@fly-novel/skill-tool-core": [
        "./src/tools/skill/index.ts"
      ],
      "@fly-novel/character-system-prompt": [
        "./src/agents/character/plugins/system-prompt/index.ts"
      ],
      "@fly-novel/director-system-prompt": [
        "./src/agents/director/plugins/system-prompt/index.ts"
      ],
      "@fly-novel/world-initialization-system-prompt": [
        "./src/agents/world-initialization-main-agent/plugins/system-prompt/index.ts"
      ],
      "@fly-novel/util": [
        "./src/util/index.ts"
      ],
      "@fly-novel/agents": [
        "./src/agents/index.ts"
      ],
      "@fly-novel/agent-loop": [
        "./src/agents/plugins/loop/index.ts"
      ],
      "@fly-novel/tools": [
        "./src/agents/plugins/tools/index.ts"
      ],
      "@fly-novel/subagent": [
        "./src/agents/plugins/subagent/subagent/index.ts"
      ],
      "@fly-novel/subagent-in-process-driver": [
        "./src/agents/plugins/subagent/subagent-in-process-driver/index.ts"
      ],
      "@fly-novel/subagent-spawn-in-process": [
        "./src/agents/plugins/subagent/subagent-spawn-in-process/index.ts"
      ],
      "@fly-novel/tool-subagent": [
        "./src/agents/plugins/subagent/tool-subagent/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    ".test-dist"
  ]
}
